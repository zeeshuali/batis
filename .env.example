# Root-level .env consumed by docker-compose.yml.
# Copy this file to `.env` (gitignored) and fill in the real values.

# ── Database ──────────────────────────────────────────────────────────────────
# Inside the docker-compose network the backend reaches postgres via the
# service name (`postgres:5432`). From the host, the dev DB is on port 5434
# and the test DB is on port 5433 (see docker-compose.yml for details).
POSTGRES_PASSWORD=batis_dev

# ── Transit APIs ──────────────────────────────────────────────────────────────
# 511.org regional API — covers all 30+ Bay Area agencies.
# Register at https://511.org/open-data/token
FIVE11_API_KEY=your_511_api_key_here

# AC Transit real-time API token (GTFS-RT vehicle positions + trip updates).
ACTRANSIT_API_KEY=your_actransit_api_key_here

# URL for the AC Transit static GTFS zip (used by run_data_jobs ETL pipeline).
GTFS_STATIC_URL=https://opendata.actransit.org/transitdata/google_transit.zip

# Optional: override GTFS-RT feed URLs. Leave blank to use 511.org feeds.
GTFS_RT_VEHICLE_POSITIONS_URL=
GTFS_RT_TRIP_UPDATES_URL=

# ── Backend security ──────────────────────────────────────────────────────────
# Optional X-API-Key required on all protected endpoints.
# Leave blank to disable authentication (fine for local dev).
BACKEND_API_KEY=

# ── AI / ML ───────────────────────────────────────────────────────────────────
# Ollama runs on the host; the backend container reaches it via
# host.docker.internal (configured via extra_hosts in docker-compose.yml).
OLLAMA_MODEL=llama3.1:8b
EMBED_MODEL_NAME=all-MiniLM-L6-v2

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# These are consumed by the frontend container at start-up; docker-compose
# passes them through as VITE_* env vars.

# Mapbox GL JS public token (note: variable name is VITE_MAPBOX_ACCESS_TOKEN,
# not VITE_MAPBOX_TOKEN — this matches what frontend/src/components/MapView.tsx
# actually reads). Get a token at https://account.mapbox.com
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Backend base URL as seen by the browser. The dockerized backend listens on
# host port 8001; CORS is configured to allow http://localhost:5173.
VITE_API_BASE_URL=http://localhost:8001

# Must match BACKEND_API_KEY above. Leave blank if auth is disabled.
VITE_API_KEY=
